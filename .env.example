# Copia este archivo como .env.local y rellena con tus credenciales de Supabase.
# Project Settings -> API en el dashboard de Supabase.
# Solo la clave "anon/publishable" va aquí: se expone en el bundle del navegador.
# La protección real de los datos vive en las políticas RLS, no en la clave.

VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key
